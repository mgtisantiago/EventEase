@page "/eventdetails/{EventId}"
@using EventEase.Shared.Models
@inject HttpClient Http

<h3>Detalles del Evento</h3>

@if (eventDetails != null)
{
    <p><strong>Nombre:</strong> @eventDetails.Name</p>
    <p><strong>Fecha:</strong> @eventDetails.Date</p>
    <p><strong>Ubicación:</strong> @eventDetails.Location</p>
}
else
{
    <p>Cargando...</p>
}

@code {
    [Parameter] public int EventId { get; set; }
    private Event? eventDetails;

    protected override async Task OnInitializedAsync()
    {
        eventDetails = await Http.GetFromJsonAsync<Event>($"data/events/{EventId}.json");
    }
}
